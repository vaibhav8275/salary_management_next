# Deploy-time values for the Next.js frontend. Gitignored -- this is the template.
# Copy to .env and fill it in: `cp .env.example .env`
#
# These are read by the ERB block in config/deploy.yml, not by Next.js. Kamal
# renders that ERB on the machine running the deploy, before it parses any YAML,
# and Kamal does not load .env itself -- so deploy.yml requires dotenv directly.
#
# That is also why none of these need to be `secret`. There is no secret here:
# an Elastic IP, an AWS account id and an SSH username are infrastructure
# identifiers. They are kept out of the repository to avoid hard-coding one
# deployment into shared config, not because they are confidential. Nothing here
# needs rotating.
#
# Values that DO have to stay secret never come from this file. The ECR registry
# token is a `$(...)` command reference in .kamal/secrets-common.

# --- Deploy target ---------------------------------------------------------
# The host to deploy to. Reached over SSH and used as the only server in
# servers.web.
EIP=

# --- AWS -------------------------------------------------------------------
# Account id, used to build registry.server as
# <AWS_ACCOUNT>.dkr.ecr.<region>.amazonaws.com
AWS_ACCOUNT=
AWS_REGION=us-east-1

# --- SSH -------------------------------------------------------------------
# Login user on the host, and the private key to authenticate with. Only the
# PATH is set here; the key file itself stays outside the repository and is
# never read by Kamal or Docker.
SSH_USER=
SSH_KEY_PATH=

# --- Runtime ---------------------------------------------------------------
# Absolute URL of the Rails API. Injected into the container as a `clear` env
# value and read at run time by src/lib/api.ts, so it is NOT baked into the
# image and NOT visible to the browser. Only NEXT_PUBLIC_* variables would be.
#
# Keep it as its own variable rather than deriving it from EIP: this is "where
# the API lives", which is a different question from "where this frontend is
# deployed". The two happen to be the same host today and need not stay that way.
#
# Must stay http while TLS is off. An https:// fetch here fails the handshake and
# every server-rendered page that touches the API errors out.
RAILS_API_URL=
